MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai
# Builder / chat model (the documented default agent model)
MUSE_CODE_MODEL=muse-spark-1.3
MUSE_CHAT_MODEL=muse-spark-1.3
# Architect (opt-in Wonder mode) and the rest of the family
MUSE_ARCHITECT_MODEL=muse-wonder-1.0
MUSE_CONTRIBUTOR_MODEL=muse-spark-1.3-contributor
MUSE_IMAGE_MODEL=muse-image-1.0
# Maximum images generated automatically per build (default 6, max 30)
MUSE_BUILD_IMAGES=6
MUSE_SAM_MODEL=sam-3.1
MUSE_VOICE_MODEL=muse-voice-transcribe-1.0
# Set to 1 to send Responses-API reasoning effort on the chat surface.
MUSE_REASONING=0

# House key budget, USD per UTC day. 80% is a soft warn, 100% a hard stop —
# a visitor's own key is never capped. Leave empty for "uncapped".
MUSE_DAILY_CAP=5
# Set to 1 on the deployed site so /status reports live:true. CI never sets it.
MUSE_LIVE=1
