{
  "name": "museware",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Museware — the canvas where the muse builds with you.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:tokens": "node scripts/check-tokens.mjs && node scripts/check-shell-style.mjs && node scripts/check-shell-style.mjs --self-test",
    "check:dist": "node scripts/check-dist.mjs",
    "check:export": "vite-node scripts/check-export.ts",
    "check": "npm run typecheck && npm run lint && npm run check:tokens && npm test && npm run check:api:fresh && npm run build-api && npm run check:api",
    "build-api": "node scripts/build-api.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check:api:fresh": "node scripts/build-api.mjs --check",
    "build:all": "npm run build && npm run build-api"
  },
  "dependencies": {
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "idb": "8.0.0",
    "jszip": "3.10.1",
    "lucide-react": "0.462.0",
    "nanoid": "5.0.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8",
    "zod-to-json-schema": "3.23.5",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.24.0",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "prettier": "3.3.3",
    "typescript": "5.5.4",
    "vite": "5.4.21",
    "vite-node": "2.1.9",
    "vitest": "2.1.9"
  }
}
